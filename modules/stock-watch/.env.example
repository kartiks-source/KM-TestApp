# Port to listen on
PORT=4400
# Set to require a password for the page and API (user name: anything)
ADMIN_PASSWORD=
# Where store.json is kept (mount a volume here in production)
DATA_DIR=./data

# Shopify, read-only. Option 1 (preferred): Azure Key Vault, reads shopify-<SHOPIFY_STORE>-client-id and -client-secret
SHOPIFY_STORE=
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Option 2 (stop-gap): the app's client ID + secret as variables (Shopify Dev Dashboard app, same organisation as the store)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Legacy only: a custom-app admin token (shpat_…), if that's all there is
# SHOPIFY_ACCESS_TOKEN=
