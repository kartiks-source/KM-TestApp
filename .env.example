# Port to listen on
PORT=4400
# Set to require a password for the page and API (user name: anything)
ADMIN_PASSWORD=
# Where store.json is kept (mount a volume here in production)
DATA_DIR=./data

# Shopify, read-only. Option 1 (preferred): Azure Key Vault, reads secret shopify-<SHOPIFY_STORE>
SHOPIFY_STORE=
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Option 2 (stop-gap): the key as a variable
SHOPIFY_ACCESS_TOKEN=
